# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed — it's already in .gitignore.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=PLACEHOLDER_DB_NAME_SIDEBAR
DB_USER=PLACEHOLDER_DB_USER_SIDEBAR
DB_PASS=PLACEHOLDER_DB_PASSWORD_SIDEBAR

# Optional: toggle verbose error output locally vs. production.
APP_ENV=local
APP_DEBUG=true
