# Root .htaccess

# Defense-in-depth: never serve dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Block direct browser access to config/, includes/, and vendor/
RewriteRule ^(config|includes|vendor)(/|$) - [F,L]

# If the request is for the root folder itself, pass it to public/
RewriteRule ^$ public/ [L]

# Serve real files/directories (css, js, images inside public/) directly.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Everything else goes through the front controller.
RewriteRule ^(.*)$ public/$1 [L]